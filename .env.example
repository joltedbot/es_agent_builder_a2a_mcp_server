# .env — Single source of truth for all credentials.
# This file is gitignored. Never commit secrets.

# Elastic Agent Builder (required if using Elastic provider)
KIBANA_URL=https://your-deployment.kb.elastic-cloud.com
ELASTIC_API_KEY=your-api-key-here

# Additional A2A agent tokens (referenced by envVar in agents.json)
# MY_AGENT_TOKEN=your-token-here

# A2A Inbound Server (npm run serve)
# A2A_SERVER_TOKEN=your-secret-token  # Bearer token for inbound auth (optional for localhost)
# A2A_PORT=3008                        # Default port
# A2A_HOST=127.0.0.1                   # Default bind address (localhost only)
# A2A_WORK_DIR=.                       # Working directory for claude -p
# A2A_EXEC_TIMEOUT=120000              # Claude execution timeout in ms
